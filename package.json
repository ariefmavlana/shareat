{
  "name": "shareat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "prepare": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-demo.ts",
    "staff:create": "tsx scripts/create-staff.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "jobs:run": "tsx scripts/maintenance.ts",
    "preflight": "tsx scripts/preflight.ts",
    "format": "prettier --write app server shared scripts tests nuxt.config.ts drizzle.config.ts vitest.config.ts playwright.config.ts vitest.integration.config.ts",
    "format:check": "prettier --check app server shared scripts tests nuxt.config.ts drizzle.config.ts vitest.config.ts playwright.config.ts vitest.integration.config.ts",
    "backup:check": "tsx scripts/backup-check.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@lucide/vue": "1.51.0",
    "@vueuse/core": "15.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "nuxt": "4.5.2",
    "otplib": "13.5.0",
    "reka-ui": "2.10.5",
    "shadcn-nuxt": "2.8.2",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "vue": "3.5.43",
    "vue-router": "5.3.1",
    "zod": "4.6.5",
    "h3": "1.15.11",
    "ofetch": "1.5.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "dotenv": "18.0.5",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12",
    "prettier": "3.8.3",
    "@types/pg": "8.23.1"
  }
}
