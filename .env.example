# Copy to .env. Generate independent secrets; never commit .env.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
NUXT_DATABASE_URL=mysql://shareat:REPLACE@127.0.0.1:33067/shareat
NUXT_ENCRYPTION_KEY=
NUXT_APP_MODE=demo
NUXT_SITE_URL=http://localhost:3000
NUXT_PROXY_TRUSTED=false
NUXT_MEDIA_ROOT=.data/media
NUXT_SCANNER_COMMAND=
DEMO_STAFF_PASSWORD=
# Demo seed is blocked outside NUXT_APP_MODE=demo.
# OTP enrollment secrets are generated locally in .data/demo-access.json.

# For remote MySQL require certificate validation. No insecure TLS bypass.
NUXT_DATABASE_TLS=false
NUXT_DATABASE_CA=
BACKUP_MANIFEST_PATH=
# Private CLI bootstrap only, clear after provisioning.
STAFF_EMAIL=
STAFF_PASSWORD=
STAFF_TEAM_NAME=
STAFF_ROLES=
